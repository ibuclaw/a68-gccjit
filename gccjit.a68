    (JIT_Type res;
     jit_type of res := c_type_get_aligned(jit_type of type, alignment);
     res);

  { Given type `T`, get type: `T __attribute__ ((vector_size (sizeof(T) * num_units))`
    "type" must be integral/floating point; "num_units" must be a power of two. }
  pub proc type_get_vector = (JIT_Type type, long long int num_units) JIT_Type:
    (JIT_Type res;
     jit_type of res := c_type_get_vector(jit_type of type, num_units);
     res);

