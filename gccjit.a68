  { ////////////////////////////////////////////////////////////////////////// }
  { Private definitions }
  { ////////////////////////////////////////////////////////////////////////// }
  { These are the formal hole definitions taken from libgccjit.h

    Some of the deliberate choices made for Algol68 include:
    - All `structs` within the C API are opaque and mapped to a `ref struct`
      named "GccJitHandle".  Modes that enforce the correct reference (pointer)
      is passed is done in the public interface.
    - All C `enums` are mapped to `int`, modes that enforce which kind of
      enum should be passed is done in the public interface.
    - Some C `int` parameters are mapped to `bool` where the accepted input is
      clearly meant to be either 0 or 1.
    - C `char *` is mapped to `string`. These types are not compatible, but
      GA68 lowers these to `(uint32_t*, size_t, size_t)`, which allows us to
      implement a "glue" function to convert strings between the two languages.
    - C `struct **` arrays are mapped to `[]GccJitHandle`, for the same reasons
      as with mapping to strings.
    - C `FILE *` is mapped to `FIXME_FilePtr` - TODO for later.
    - C `void *` is mapped to `FIXME_VoidPtr` - TODO for later.
    - C `char **` is mapped to `FIXME_StringPtr` - TODO for later.
  }
  mode GccJitHandle = ref struct (int handle);
  mode FIXME_FilePtr = ref struct (int fileptr);
  mode FIXME_VoidPtr = ref struct (int bottom);
  mode FIXME_StringPtr = ref struct (int stringptr);

  proc GccJitHandle c_context_acquire = nest C "gcc_jit_context_acquire";
  proc (GccJitHandle) void c_context_release = nest C "gcc_jit_context_release";

  proc (GccJitHandle, int, string) void c_context_set_str_option = nest C "gcc_jit_context_set_str_option";
  proc (GccJitHandle, int, int) void c_context_set_int_option = nest C "gcc_jit_context_set_int_option";
  proc (GccJitHandle, int, bool) void c_context_set_bool_option = nest C "gcc_jit_context_set_bool_option";
  proc (GccJitHandle, bool) void c_context_set_bool_allow_unreachable_blocks = nest C "gcc_jit_context_set_bool_allow_unreachable_blocks";
  proc (GccJitHandle, bool) void c_context_set_bool_print_errors_to_stderr = nest C "gcc_jit_context_set_bool_print_errors_to_stderr";
  proc (GccJitHandle, bool) void c_context_set_bool_use_external_driver = nest C "gcc_jit_context_set_bool_use_external_driver";
  proc (GccJitHandle, string) void c_context_add_command_line_option = nest C "gcc_jit_context_add_command_line_option";
  proc (GccJitHandle, string) void c_context_add_driver_option = nest C "gcc_jit_context_add_driver_option";
  proc (GccJitHandle) GccJitHandle c_context_compile = nest C "gcc_jit_context_compile";
  proc (GccJitHandle, int, string) void c_context_compile_to_file = nest C "gcc_jit_context_compile_to_file";
  proc (GccJitHandle, string, int) void c_context_dump_to_file = nest C "gcc_jit_context_dump_to_file";
  proc (GccJitHandle, FIXME_FilePtr, int, int) void c_context_set_logfile = nest C "gcc_jit_context_set_logfile";
  proc (GccJitHandle) string c_context_get_first_error = nest C "gcc_jit_context_get_first_error";
  proc (GccJitHandle) string c_context_get_last_error = nest C "gcc_jit_context_get_last_error";

  proc (GccJitHandle, string) FIXME_VoidPtr c_result_get_code = nest C "gcc_jit_result_get_code";
  proc (GccJitHandle, string) FIXME_VoidPtr c_result_get_global = nest C "gcc_jit_result_get_global";
  proc (GccJitHandle) void c_result_release = nest C "gcc_jit_result_release";

  proc (GccJitHandle) GccJitHandle c_object_get_context = nest C "gcc_jit_object_get_context";
  proc (GccJitHandle) string c_object_get_debug_string = nest C "gcc_jit_object_get_debug_string";

  proc (GccJitHandle, string, int, int) GccJitHandle c_context_new_location = nest C "gcc_jit_context_new_location";
  proc (GccJitHandle) GccJitHandle c_location_as_object = nest C "gcc_jit_location_as_object";

  proc (GccJitHandle) GccJitHandle c_type_as_object = nest C "gcc_jit_type_as_object";
  proc (GccJitHandle, int) GccJitHandle c_context_get_type = nest C "gcc_jit_context_get_type";
  proc (GccJitHandle, int, bool) GccJitHandle c_context_get_int_type = nest C "gcc_jit_context_get_int_type";

  proc (GccJitHandle) GccJitHandle c_type_get_pointer = nest C "gcc_jit_type_get_pointer";
  proc (GccJitHandle) GccJitHandle c_type_get_const = nest C "gcc_jit_type_get_const";
  proc (GccJitHandle) GccJitHandle c_type_get_volatile = nest C "gcc_jit_type_get_volatile";
