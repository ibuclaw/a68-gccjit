module Gccjit =
def
  { Data structures. }
  pub mode JIT_Context       = struct (GccJitHandle jit_context),
           JIT_Result        = struct (GccJitHandle jit_result),
           JIT_Targetinfo    = struct (GccJitHandle jit_targetinfo),
           JIT_Location      = struct (GccJitHandle jit_location),
           JIT_Type          = struct (GccJitHandle jit_type),
           JIT_Struct        = struct (GccJitHandle jit_struct),
           JIT_Function_Type = struct (GccJitHandle jit_function_type),
           JIT_Vector_Type   = struct (GccJitHandle jit_vector_type),
           JIT_Field         = struct (GccJitHandle jit_field),
           JIT_Function      = struct (GccJitHandle jit_function),
           JIT_Block         = struct (GccJitHandle jit_block),
           JIT_Rvalue        = struct (GccJitHandle jit_rvalue),
           JIT_Lvalue        = struct (GccJitHandle jit_lvalue),
           JIT_Param         = struct (GccJitHandle jit_param),
           JIT_Case          = struct (GccJitHandle jit_case),
           JIT_Extended_Asm  = struct (GccJitHandle jit_extended_asm),
           JIT_Timer         = struct (GccJitHandle jit_timer);

  {{pub}} mode JIT_Object    = struct (GccJitHandle jit_object),

  { The class hierachy looks like this:
     +- gcc_jit_object
         +- gcc_jit_location
         +- gcc_jit_type
            +- gcc_jit_struct
            +- gcc_jit_function_type
            +- gcc_jit_vector_type
         +- gcc_jit_field
         +- gcc_jit_function
         +- gcc_jit_block
         +- gcc_jit_rvalue
             +- gcc_jit_lvalue
                 +- gcc_jit_param
         +- gcc_jit_case
         +- gcc_jit_extended_asm
  }
  mode JIT_Object_Variant = union (JIT_Location, JIT_Type, JIT_Field, JIT_Param,
                                   JIT_Function, JIT_Block, JIT_Lvalue, JIT_Rvalue,
                                   JIT_Case, JIT_Extended_Asm);
  mode JIT_Type_Variant = union (JIT_Type, JIT_Struct, JIT_Function_Type, JIT_Vector_Type);
  mode JIT_RValue_Variant = union (JIT_Rvalue, JIT_Lvalue, JIT_Param);
  mode JIT_LValue_Variant = union (JIT_Lvalue, JIT_Param);

  { Options taking string values. }
  {{pub}} mode Str_Option = struct (int str_option);
  {{pub}} Str_Option option_progname,
                     option_special_chars_in_func_names;
  str_option of option_progname := 0;
  str_option of option_special_chars_in_func_names := 1;

  { Options taking int values. }
  {{pub}} mode Int_Option = struct (int int_option);
  {{pub}} Int_Option option_optimization_level;
  int_option of option_optimization_level := 0;

  { Options taking boolean values. }
  {{pub}} mode Bool_Option = struct (int bool_option);
  {{pub}} Bool_Option option_debuginfo,
                      option_dump_initial_tree,
                      option_dump_initial_gimple,
                      option_dump_generated_code,
                      option_dump_summary,
                      option_dump_everything,
                      option_selfcheck_gc,
                      option_keep_intermediates;
  bool_option of option_debuginfo := 0;
  bool_option of option_dump_initial_tree := 1;
  bool_option of option_dump_initial_gimple := 2;
  bool_option of option_dump_generated_code := 3;
  bool_option of option_dump_summary := 4;
  bool_option of option_dump_everything := 5;
  bool_option of option_selfcheck_gc := 6;
  bool_option of option_keep_intermediates := 7;

  { Kinds of ahead-of-time compilation. }
  pub mode Output_Kind = struct (int output_kind);
  pub Output_Kind output_assembler,
                  output_object_file,
                  output_dynamic_library,
                  output_executable;
  output_kind of output_assembler := 0;
  output_kind of output_object_file := 1;
  output_kind of output_dynamic_library := 2;
  output_kind of output_executable := 3;

  { Access to specific types. }
  pub mode CType = struct (int ctype);
  pub CType type_void,
            type_void_ptr,
            type_bool,
            type_char,
            type_signed_char,
            type_unsigned_char,
            type_short,
            type_unsigned_short,
            type_int,
            type_unsigned_int,
            type_long,
            type_unsigned_long,
            type_long_long,
            type_unsigned_long_long,
            type_float,
            type_double,
            type_long_double,
            type_const_char_ptr,
            type_size_t,
            type_file_ptr,
            type_complex_float,
            type_complex_double,
            type_complex_long_double,
            type_uint8_t,
            type_uint16_t,
            type_uint32_t,
            type_uint64_t,
            type_uint128_t,
            type_int8_t,
            type_int16_t,
            type_int32_t,
            type_int64_t,
            type_int128_t,
            type_bfloat16,
            type_float16,
            type_float32,
            type_float64,
            type_float128;
  ctype of type_void := 0;
  ctype of type_void_ptr := 1;
  ctype of type_bool := 2;
  ctype of type_char := 3;
  ctype of type_signed_char := 4;
  ctype of type_unsigned_char := 5;
  ctype of type_short := 6;
  ctype of type_unsigned_short := 7;
  ctype of type_int := 8;
  ctype of type_unsigned_int := 9;
  ctype of type_long := 10;
  ctype of type_unsigned_long := 11;
  ctype of type_long_long := 12;
  ctype of type_unsigned_long_long := 13;
  ctype of type_float := 14;
  ctype of type_double := 15;
  ctype of type_long_double := 16;
  ctype of type_const_char_ptr := 17;
  ctype of type_size_t := 18;
  ctype of type_file_ptr := 19;
  ctype of type_complex_float := 20;
  ctype of type_complex_double := 21;
  ctype of type_complex_long_double := 22;
  ctype of type_uint8_t := 23;
  ctype of type_uint16_t := 24;
  ctype of type_uint32_t := 25;
  ctype of type_uint64_t := 26;
  ctype of type_uint128_t := 27;
  ctype of type_int8_t := 28;
  ctype of type_int16_t := 29;
  ctype of type_int32_t := 30;
  ctype of type_int64_t := 31;
  ctype of type_int128_t := 32;
  ctype of type_bfloat16 := 33;
  ctype of type_float16 := 34;
  ctype of type_float32 := 35;
  ctype of type_float64 := 36;
  ctype of type_float128 := 37;

  { Kinds of function. }
  pub mode Function_Kind = struct (int function_kind);
  pub Function_Kind function_exported,
                    function_internal,
                    function_imported,
                    function_always_inline;
  function_kind of function_exported := 0;
  function_kind of function_internal := 1;
  function_kind of function_imported := 2;
  function_kind of function_always_inline := 3;

  { Thread local storage model. }
  pub mode Tls_Model = struct (int tls_model);
  pub Tls_Model tls_none,
                tls_global_dynamic,
                tls_local_dynamic,
                tls_initial_exec,
                tls_local_exec;
  tls_model of tls_none := 0;
  tls_model of tls_global_dynamic := 1;
  tls_model of tls_local_dynamic := 2;
  tls_model of tls_initial_exec := 3;
  tls_model of tls_local_exec := 4;

  { Kinds of global. }
  pub mode Global_Kind = struct (int global_kind);
  pub Global_Kind global_exported,
                  global_internal,
                  global_imported;
  global_kind of global_exported := 0;
  global_kind of global_internal := 1;
  global_kind of global_imported := 2;

  { Unary operations. }
  pub mode Unary_Op = struct (int unary_op);
  pub Unary_Op unary_minus,
               unary_bitwise_negate,
               unary_logical_negate,
               unary_abs;
  unary_op of unary_minus := 0;
  unary_op of unary_bitwise_negate := 1;
  unary_op of unary_logical_negate := 2;
  unary_op of unary_abs := 3;

  { Binary operations. }
  pub mode Binary_Op = struct (int binary_op);
  pub Binary_Op binary_plus,
                binary_minus,
                binary_mult,
                binary_divide,
                binary_modulo,
                binary_bitwise_and,
                binary_bitwise_xor,
                binary_bitwise_or,
                binary_logical_and,
                binary_logical_or,
                binary_lshift,
                binary_rshift;
  binary_op of binary_plus := 0;
  binary_op of binary_minus := 1;
  binary_op of binary_mult := 2;
  binary_op of binary_divide := 3;
  binary_op of binary_modulo := 4;
  binary_op of binary_bitwise_and := 5;
  binary_op of binary_bitwise_xor := 6;
  binary_op of binary_bitwise_or := 7;
  binary_op of binary_logical_and := 8;
  binary_op of binary_logical_or := 9;
  binary_op of binary_lshift := 10;
  binary_op of binary_rshift := 11;

  { Comparisons. }
  pub mode Comparison = struct (int comparison);
  pub Comparison comparison_eq,
                 comparison_ne,
                 comparison_lt,
                 comparison_le,
                 comparison_gt,
                 comparison_ge;
  comparison of comparison_eq := 0;
  comparison of comparison_ne := 1;
  comparison of comparison_lt := 2;
  comparison of comparison_le := 3;
  comparison of comparison_gt := 4;
  comparison of comparison_ge := 5;

  { Function attributes. }
  pub mode Fn_Attribute = struct (int fn_attribute);
  pub Fn_Attribute fn_attribute_alias,
                   fn_attribute_always_inline,
                   fn_attribute_inline,
                   fn_attribute_noinline,
                   fn_attribute_target,
                   fn_attribute_used,
                   fn_attribute_visibility,
                   fn_attribute_cold,
                   fn_attribute_returns_twice,
                   fn_attribute_pure,
                   fn_attribute_const,
                   fn_attribute_weak,
                   fn_attribute_nonnull,
                   arm_cmse_nonsecure_call,
                   arm_cmse_nonsecure_entry,
                   arm_pcs,
                   avr_interrupt,
                   avr_noblock,
                   avr_signal,
                   gcn_amdgpu_hsa_kernel,
                   msp430_interrupt,
                   nvptx_kernel,
                   riscv_interrupt,
                   x86_fast_call,
                   x86_interrupt,
                   x86_ms_abi,
                   x86_stdcall,
                   x86_sysv_abi,
                   x86_this_call;
  fn_attribute of fn_attribute_alias := 0;
  fn_attribute of fn_attribute_always_inline := 1;
  fn_attribute of fn_attribute_inline := 2;
  fn_attribute of fn_attribute_noinline := 3;
  fn_attribute of fn_attribute_target := 4;
  fn_attribute of fn_attribute_used := 5;
  fn_attribute of fn_attribute_visibility := 6;
  fn_attribute of fn_attribute_cold := 7;
  fn_attribute of fn_attribute_returns_twice := 8;
  fn_attribute of fn_attribute_pure := 9;
  fn_attribute of fn_attribute_const := 10;
  fn_attribute of fn_attribute_weak := 11;
  fn_attribute of fn_attribute_nonnull := 12;
  fn_attribute of arm_cmse_nonsecure_call := 13;
  fn_attribute of arm_cmse_nonsecure_entry := 14;
  fn_attribute of arm_pcs := 15;
  fn_attribute of avr_interrupt := 16;
  fn_attribute of avr_noblock := 17;
  fn_attribute of avr_signal := 18;
  fn_attribute of gcn_amdgpu_hsa_kernel := 19;
  fn_attribute of msp430_interrupt := 20;
  fn_attribute of nvptx_kernel := 21;
  fn_attribute of riscv_interrupt := 22;
  fn_attribute of x86_fast_call := 23;
  fn_attribute of x86_interrupt := 24;
  fn_attribute of x86_ms_abi := 25;
  fn_attribute of x86_stdcall := 26;
  fn_attribute of x86_sysv_abi := 27;
  fn_attribute of x86_this_call := 28;

  { Variable attributes. }
  pub mode Var_Attribute = struct (int var_attribute);
  pub Var_Attribute var_attribute_visibility;
  var_attribute of var_attribute_visibility := 0;

  { Acquire a JIT-compilation context. }
  pub proc jit_acquire = JIT_Context:
    (JIT_Context res;
     jit_context of res := c_context_acquire;
     res);

  { Release the context. }
  pub proc jit_release = (JIT_Context ctxt) void:
    c_context_release(jit_context of ctxt);

  { FIXME: string -> char* }
  { Set the name of the program, for use as a prefix when printing error messages to stderr. }
  pub proc set_program_name = (JIT_Context ctxt, string value) void:
    c_context_set_str_option(jit_context of ctxt,
                             str_option of option_progname,
                             value);

  { FIXME: string -> char* }
  { Set which special characters are allowed in function names. }
  pub proc set_special_chars_in_func_names = (JIT_Context ctxt, string value) void:
    c_context_set_str_option(jit_context of ctxt,
                             str_option of option_special_chars_in_func_names,
                             value);

  { Set how much to optimize the code. }
  pub proc set_optimization_level = (JIT_Context ctxt, int value) void:
    c_context_set_int_option(jit_context of ctxt,
                             int_option of option_optimization_level,
                             value);

  { Enable debug info generation. }
  pub proc set_debuginfo = (JIT_Context ctxt, bool value) void:
    c_context_set_bool_option(jit_context of ctxt,
                              bool_option of option_debuginfo,
                              value);

  { Enable dumps of libgccjit's initial tree representation of your code to stderr. }
  pub proc set_dump_initial_tree = (JIT_Context ctxt, bool value) void:
    c_context_set_bool_option(jit_context of ctxt,
                              bool_option of option_dump_initial_tree,
                              value);

  { Enable dumps of libgccjit's gimple representation of your code to stderr. }
  pub proc set_dump_initial_gimple = (JIT_Context ctxt, bool value) void:
    c_context_set_bool_option(jit_context of ctxt,
                              bool_option of option_dump_initial_gimple,
                              value);

  { Enable dumps of libgccjit's final generated code to stderr. }
  pub proc set_dump_generated_code = (JIT_Context ctxt, bool value) void:
    c_context_set_bool_option(jit_context of ctxt,
                              bool_option of option_dump_generated_code,
                              value);

  { Enable printing of information to stderr on the actions libgccjit is performing. }
  pub proc set_dump_summary = (JIT_Context ctxt, bool value) void:
    c_context_set_bool_option(jit_context of ctxt,
                              bool_option of option_dump_summary,
                              value);

  { Enable dumping of copius amounts of information on what libgccjit is doing to
    various files within a temporary directory. }
  pub proc set_dump_everything = (JIT_Context ctxt, bool value) void:
    c_context_set_bool_option(jit_context of ctxt,
                              bool_option of option_dump_everything,
                              value);

  { Enable aggressive runs of libgccjit's garbage collector. }
  pub proc set_selfcheck_gc = (JIT_Context ctxt, bool value) void:
    c_context_set_bool_option(jit_context of ctxt,
                              bool_option of option_selfcheck_gc,
                              value);

  { Disable clean up of intermediate files written to the filesystem. }
  pub proc set_keep_intermediates = (JIT_Context ctxt, bool value) void:
    c_context_set_bool_option(jit_context of ctxt,
                              bool_option of option_keep_intermediates,
                              value);

  { Disable errors for unreachable blocks. }
  pub proc set_allow_unreachable_blocks = (JIT_Context ctxt, bool value) void:
    c_context_set_bool_allow_unreachable_blocks(jit_context of ctxt, value);

  { Disable printing errors to stderr. }
  pub proc set_print_errors_to_stderr = (JIT_Context ctxt, bool value) void:
    c_context_set_bool_print_errors_to_stderr(jit_context of ctxt, value);

  { Use an external driver executable instead of the embedded driver. }
  pub proc set_use_external_driver = (JIT_Context ctxt, bool value) void:
    c_context_set_bool_use_external_driver(jit_context of ctxt, value);

  { FIXME: string -> char* }
  { Add an arbitrary GCC command-line option to the context. }
  pub proc jit_add_command_line_option = (JIT_Context ctxt, string s) void:
    c_context_add_command_line_option(jit_context of ctxt, s);

  { FIXME: string -> char* }
  { Add an arbitrary GCC driver option to the context. }
  pub proc jit_add_driver_option = (JIT_Context ctxt, string s) void:
    c_context_add_driver_option(jit_context of ctxt, s);

  { Compile the context to in-memory machine code. }
  pub proc jit_compile = (JIT_Context ctxt) JIT_Result:
    (JIT_Result res;
     jit_result of res := c_context_compile(jit_context of ctxt);
     res);

  { FIXME: string -> char* }
  { Compile the context to a file of the given kind. }
  pub proc jit_compile_to_file = (JIT_Context ctxt, Output_Kind kind , string filename) void:
    c_context_compile_to_file(jit_context of ctxt,
                              output_kind of kind,
                              filename);

  { FIXME: string -> char* }
  { Dump a C-like representation of the context to the given path. }
  pub proc jit_dump_to_file = (JIT_Context ctxt, string path, int update_locations) void:
    c_context_dump_to_file(jit_context of ctxt,
                           path, update_locations);

  { FIXME: int -> FILE }
  { Enable ongoing logging of the context's activity to the given logfile. }
  pub proc jit_set_logfile = (JIT_Context ctxt, FIXME_FilePtr logfile,
                              int flags, int verbosity) void:
    c_context_set_logfile(jit_context of ctxt,
                          logfile, flags, verbosity);

  { FIXME: char* -> string }
  { Get the first error message that occurred on the context. }
  pub proc jit_get_first_error = (JIT_Context ctxt) string:
    c_context_get_first_error(jit_context of ctxt);

  { FIXME: char* -> string }
  { Get the last error message that occurred on the context. }
  pub proc jit_get_last_error = (JIT_Context ctxt) string:
    c_context_get_last_error(jit_context of ctxt);

  { FIXME: Return a proc }
  { Locate a function within the built machine code. }
  pub proc result_get_code = (JIT_Result result, string name) FIXME_VoidPtr:
    c_result_get_code(jit_result of result, name);

  { FIXME: Return a ref to something }
  { Locate a global within the built machine code. }
  pub proc result_get_global = (JIT_Result result, string name) FIXME_VoidPtr:
    c_result_get_global(jit_result of result, name);

  { Release the result and unload the built shared library. }
  pub proc result_release = (JIT_Result result) void:
    c_result_release(jit_result of result);

  { Which context is "variant" within? }
  pub proc jit_get_context = (JIT_Object_Variant variant) JIT_Context:
    (JIT_Context res;
     jit_context of res := c_object_get_context(jit_object of as_object(variant));
     res);

  { FIXME: char* -> string }
  { Get a human-readable description of this object. }
  pub proc jit_get_debug_string = (JIT_Object_Variant variant) string:
    c_object_get_debug_string(jit_object of as_object(variant));

  { FIXME: string -> char* }
  { Create a source code location for use by the debugger. }
  pub proc jit_new_location = (JIT_Context ctxt, string filename,
                               int line, int column) JIT_Location:
    (JIT_Location res;
     jit_location of res := c_context_new_location(jit_context of ctxt,
                                                   filename, line, column);
     res);

  { Upcasting to object. }
  proc as_object = (JIT_Object_Variant variant) JIT_Object:
    (JIT_Object res;
     jit_object of res := case variant in
       (JIT_Location location): c_location_as_object(jit_location of location),
       (JIT_Type type):         c_type_as_object(jit_type of type),
       (JIT_Field field):       c_field_as_object(jit_field of field),
       (JIT_Param param):       c_param_as_object(jit_param of param),
       (JIT_Function function): c_function_as_object(jit_function of function),
       (JIT_Block block):       c_block_as_object(jit_block of block),
       (JIT_Lvalue lvalue):     c_lvalue_as_object(jit_lvalue of lvalue),
       (JIT_Rvalue rvalue):     c_rvalue_as_object(jit_rvalue of rvalue),
       (JIT_Case case_):        c_case_as_object(jit_case of case_),
       (JIT_Extended_Asm asm):  c_extended_asm_as_object(jit_extended_asm of asm)
     esac;
     res);

  { Get a type from the context. }
  pub proc jit_get_type = (JIT_Context ctxt, CType type) JIT_Type:
    (JIT_Type res;
     jit_type of res := c_context_get_type(jit_context of ctxt,
                                           ctype of type);
     res);

  { Get the integer type of the given size and signedness. }
  pub proc jit_get_int_type = (JIT_Context ctxt, int num_bytes, bool is_signed) JIT_Type:
    (JIT_Type res;
     jit_type of res := c_context_get_int_type(jit_context of ctxt,
                                               num_bytes, is_signed);
     res);

  { Given type `T`, get type `T*`. }
  pub proc type_get_pointer = (JIT_Type type) JIT_Type:
    (JIT_Type res;
     jit_type of res := c_type_get_pointer(jit_type of type);
     res);

  { Given type `T`, get type `const T`. }
  pub proc type_get_const = (JIT_Type type) JIT_Type:
    (JIT_Type res;
     jit_type of res := c_type_get_const(jit_type of type);
     res);

  { Given type `T`, get type `volatile T`. }
  pub proc type_get_volatile = (JIT_Type type) JIT_Type:
    (JIT_Type res;
     jit_type of res := c_type_get_volatile(jit_type of type);
     res);

  { Given type `T`, get type `restrict T`. }
  pub proc type_get_restrict = (JIT_Type type) JIT_Type:
    (JIT_Type res;
     jit_type of res := c_type_get_restrict(jit_type of type);
     res);

  { FIXME: union(JIT_Type, JIT_Struct) ptr and upcast }
  { Given types LTYPE and RTYPE, return non-zero if they are compatible. }
  pub proc compatible_types = (JIT_Type a, JIT_Type b) int:
    c_compatible_types(jit_type of a,
                       jit_type of b);

  { Given type `T`, get its size. }
  pub proc type_get_size = (JIT_Type type) long long int:
    c_type_get_size(jit_type of type);

  { FIXME: union(JIT_Type, JIT_Struct) ptr and upcast }
  { Create an array type T[N] for a constant N. }
  pub proc jit_new_array_type = (JIT_Context ctxt, JIT_Location location,
                                 JIT_Type element_type, int num_elements) JIT_Type:
    (JIT_Type res;
     jit_type of res := c_context_new_array_type(jit_context of ctxt,
                                                 jit_location of location,
                                                 jit_type of element_type,
                                                 num_elements);
     res);

  { FIXME: union(JIT_Type, JIT_Struct) ptr and upcast }
  { Create an array type T[N] using a 64-bit element count. }
  pub proc jit_new_array_type_u64 = (JIT_Context ctxt, JIT_Location location,
                                     JIT_Type element_type, long long int num_elements) JIT_Type:
    (JIT_Type res;
     jit_type of res := c_context_new_array_type_u64(jit_context of ctxt,
                                                     jit_location of location,
                                                     jit_type of element_type,
                                                     num_elements);
     res);

  { FIXME: string -> char* }
  { FIXME: union(JIT_Type, JIT_Struct) ptr and upcast }
  { Create a field, for use within a struct or union. }
  pub proc jit_new_field = (JIT_Context ctxt, JIT_Location location,
                            JIT_Type type, string name) JIT_Field:
    (JIT_Field res;
     jit_field of res := c_context_new_field(jit_context of ctxt,
                                             jit_location of location,
                                             jit_type of type,
                                             name);
     res);

  { FIXME: string -> char* }
  { Create a bit field for use within a struct or union. }
  pub proc jit_new_bitfield = (JIT_Context ctxt, JIT_Location location,
                               JIT_Type type, int width, string name) JIT_Field:
